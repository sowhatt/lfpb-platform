NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
POSTGRES_PORT=5433
DATABASE_URL=postgresql://lfpb:lfpb_dev@localhost:5433/lfpb
REDIS_URL=redis://localhost:6379
JWT_ISSUER=lfpb-platform
JWT_AUDIENCE=lfpb-users
JWT_SECRET=change-me-with-at-least-32-random-characters
SEED_ADMIN_EMAIL=admin@lfpb.bj
SEED_ADMIN_PASSWORD=change-this-development-password
SEED_CLUB_EMAIL=admin@dragons.bj
SEED_CLUB_PASSWORD=change-this-dragons-password
SEED_COMPETITION_MANAGER_EMAIL=competitions@lfpb.bj
SEED_COMPETITION_MANAGER_PASSWORD=change-this-manager-password
SEED_SCHEDULE_APPROVER_EMAIL=validation.calendrier@lfpb.bj
SEED_SCHEDULE_APPROVER_PASSWORD=change-this-approver-password
SEED_OFFICIAL_EMAIL=arbitre.demo@lfpb.bj
SEED_OFFICIAL_PASSWORD=change-this-official-password
SEED_FEDERATION_EMAIL=licences@febefoot.bj
SEED_FEDERATION_PASSWORD=change-this-federation-password

# Notifications licences (MVP provider-agnostic)
# WHATSAPP par défaut ; mettre SMS pour tester le canal SMS.
LFPB_NOTIFICATION_CHANNEL=WHATSAPP
# Numéro du contact notifications du club, indexé par son code organisation.
LFPB_NOTIFICATION_PHONE_DRAGONS=
# Webhook facultatif vers Whatzabi/Twilio/Infobip/autre passerelle.
# Sans webhook, la notification est journalisée et auditée mais non envoyée à un opérateur externe.
LFPB_NOTIFICATION_WEBHOOK_URL=

TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=gpt-transcribe
