// Prisma schema for LFPB Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  FEDERATION
  LEAGUE
  CLUB
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum Role {
  SUPER_ADMIN
  FEDERATION_AGENT
  LIGUE_ADMIN
  CLUB_ADMIN
  CLUB_STAFF
  REFEREE
  COMMISSIONER
  DOCTOR
  SECURITY_OFFICER
}

enum RegistrationCategory {
  PLAYER
  STAFF
  OFFICIAL
}

enum RegistrationStatus {
  DRAFT
  SUBMITTED
  VALIDATED
  SUSPENDED
  ARCHIVED
}

enum PlayerPosition {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
}

enum StaffFunction {
  HEAD_COACH
  ASSISTANT_COACH
  GOALKEEPER_COACH
  FITNESS_COACH
  DOCTOR
  PHYSIOTHERAPIST
  TEAM_MANAGER
  OTHER
}

enum OfficialFunction {
  REFEREE
  ASSISTANT_REFEREE
  FOURTH_OFFICIAL
  COMMISSIONER
}

enum LicenseStatus {
  DRAFT
  SUBMITTED_TO_LEAGUE
  INCOMPLETE
  LEAGUE_FAVORABLE
  TRANSMITTED_TO_FBF
  ISSUED_BY_FBF
  REJECTED_BY_FBF
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum DocumentType {
  IDENTITY
  PHOTO
  MEDICAL_CERTIFICATE
  CONTRACT
  TRANSFER_CLEARANCE
  OTHER
}

enum DocumentStatus {
  PENDING
  VALID
  REJECTED
  EXPIRED
}

enum DocumentAnalysisStatus {
  PENDING
  PROCESSING
  REVIEW_REQUIRED
  CONSISTENT
  NON_COMPLIANT
  FAILED
}

enum SeasonStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum Division {
  LIGUE_1
  LIGUE_2
}

enum CompetitionFormat {
  ROUND_ROBIN
  DOUBLE_ROUND_ROBIN
  KNOCKOUT
  GROUPS_AND_KNOCKOUT
}

enum CompetitionStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum RoundStatus {
  DRAFT
  PUBLISHED
  COMPLETED
}

enum MatchStatus {
  DRAFT
  SCHEDULED
  POSTPONED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  HOMOLOGATED
}

enum ScheduleProposalStatus {
  DRAFT
  PUBLISHED
  APPROVED
  REJECTED
  SUPERSEDED
}

enum MatchOfficialRole {
  REFEREE
  ASSISTANT_REFEREE_1
  ASSISTANT_REFEREE_2
  FOURTH_OFFICIAL
  COMMISSIONER
}

model Organization {
  id          String             @id @default(uuid()) @db.Uuid
  type        OrganizationType
  name        String
  slug        String             @unique
  code        String?            @unique
  status      OrganizationStatus @default(ACTIVE)
  parentId    String?            @db.Uuid
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  parent      Organization?      @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Organization[]     @relation("OrganizationHierarchy")
  memberships Membership[]
  club        Club?
  registrations Registration[]
  competitions Competition[]
  venues      Venue[]
  auditLogs   AuditLog[]

  @@index([type, status])
  @@index([parentId])
}

model Club {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @unique @db.Uuid
  shortName      String
  city           String
  division       Division?
  stadiumName    String?
  foundedYear    Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  competitionEntries CompetitionClub[]
  homeMatches    Match[]      @relation("HomeClub")
  awayMatches    Match[]      @relation("AwayClub")

  @@index([division, city])
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  passwordHash String
  displayName  String
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  officialProfile OfficialProfile?
  auditLogs    AuditLog[]
  createdScheduleProposals ScheduleProposal[] @relation("ScheduleProposalCreator")
  decidedScheduleProposals ScheduleProposal[] @relation("ScheduleProposalDecider")
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  role           Role
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, role])
  @@index([organizationId, role])
}

model Person {
  id           String         @id @default(uuid()) @db.Uuid
  firstName    String
  lastName     String
  birthDate    DateTime?      @db.Date
  nationality  String?
  federationId String?        @unique
  photoDataUrl String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  registrations Registration[]

  @@index([lastName, firstName])
}

model Registration {
  id             String               @id @default(uuid()) @db.Uuid
  personId       String               @db.Uuid
  organizationId String               @db.Uuid
  category       RegistrationCategory
  deduplicationKey String?              @unique
  status         RegistrationStatus   @default(DRAFT)
  startDate      DateTime             @db.Date
  endDate        DateTime?            @db.Date
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  person         Person               @relation(fields: [personId], references: [id], onDelete: Restrict)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  playerProfile  PlayerProfile?
  staffProfile   StaffProfile?
  officialProfile OfficialProfile?
  licenses       License[]
  documents      RegistrationDocument[]

  @@index([organizationId, category, status])
  @@index([personId, status])
}

model PlayerProfile {
  registrationId String         @id @db.Uuid
  position       PlayerPosition
  shirtName      String?
  shirtNumber    Int?
  registration  Registration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

model StaffProfile {
  registrationId String        @id @db.Uuid
  function       StaffFunction
  qualification  String?
  registration   Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

model OfficialProfile {
  registrationId String           @id @db.Uuid
  userId         String?          @unique @db.Uuid
  function       OfficialFunction
  grade          String?
  registration   Registration     @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignments    MatchOfficialAssignment[]
}

model License {
  id             String        @id @default(uuid()) @db.Uuid
  registrationId String        @db.Uuid
  number         String?       @unique
  season         String
  status         LicenseStatus @default(DRAFT)
  validFrom      DateTime?     @db.Date
  validUntil     DateTime?     @db.Date
  rejectionReason String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  registration  Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId, season, status])
}

model RegistrationDocument {
  id             String         @id @default(uuid()) @db.Uuid
  registrationId String         @db.Uuid
  type           DocumentType
  storageKey     String
  status         DocumentStatus @default(PENDING)
  expiresAt      DateTime?      @db.Date
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  registration  Registration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  analysis       DocumentAnalysis?

  @@index([registrationId, type, status])
}

model DocumentAnalysis {
  id               String                 @id @default(uuid()) @db.Uuid
  documentId       String                 @unique @db.Uuid
  status           DocumentAnalysisStatus @default(PENDING)
  provider         String?
  model            String?
  confidence       Float?
  extractedData    Json?
  comparisonResult Json?
  alerts           Json?
  rawText          String?
  analyzedAt       DateTime?
  reviewedAt       DateTime?
  reviewedByUserId String?                @db.Uuid
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  document         RegistrationDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([status, confidence])
}

model Season {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @unique
  startDate    DateTime     @db.Date
  endDate      DateTime     @db.Date
  status       SeasonStatus @default(DRAFT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  competitions Competition[]

  @@index([status, startDate])
}

model Competition {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  seasonId       String            @db.Uuid
  name           String
  code           String
  division       Division?
  format         CompetitionFormat
  status         CompetitionStatus @default(DRAFT)
  minRestHours   Int               @default(72)
  maxConsecutiveHome Int            @default(2)
  maxConsecutiveAway Int            @default(2)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  season         Season            @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  entries        CompetitionClub[]
  rounds         CompetitionRound[]
  matches        Match[]
  scheduleProposals ScheduleProposal[]

  @@unique([seasonId, code])
  @@index([organizationId, status])
}

model CompetitionClub {
  competitionId String      @db.Uuid
  clubId        String      @db.Uuid
  seed          Int?
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  club          Club        @relation(fields: [clubId], references: [id], onDelete: Restrict)

  @@id([competitionId, clubId])
  @@index([clubId, active])
}

model Venue {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  city         String
  organizationId String? @db.Uuid
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  homeMatches  Match[]  @relation("MatchVenue")

  @@index([city, name])
}

model CompetitionRound {
  id            String      @id @default(uuid()) @db.Uuid
  competitionId String      @db.Uuid
  number        Int
  name          String
  startsAt      DateTime?
  endsAt        DateTime?
  status        RoundStatus @default(DRAFT)
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  matches       Match[]

  @@unique([competitionId, number])
  @@index([competitionId, status])
}

model Match {
  id            String      @id @default(uuid()) @db.Uuid
  competitionId String      @db.Uuid
  roundId       String?     @db.Uuid
  homeClubId    String      @db.Uuid
  awayClubId    String      @db.Uuid
  venueId       String?     @db.Uuid
  kickoffAt     DateTime
  status        MatchStatus @default(DRAFT)
  homeScore     Int?
  awayScore     Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  round         CompetitionRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)
  homeClub      Club        @relation("HomeClub", fields: [homeClubId], references: [id], onDelete: Restrict)
  awayClub      Club        @relation("AwayClub", fields: [awayClubId], references: [id], onDelete: Restrict)
  venue         Venue?      @relation("MatchVenue", fields: [venueId], references: [id], onDelete: SetNull)
  officialAssignments MatchOfficialAssignment[]

  @@index([competitionId, kickoffAt])
  @@index([roundId, status])
  @@index([homeClubId, kickoffAt])
  @@index([awayClubId, kickoffAt])
}

model MatchOfficialAssignment {
  id             String            @id @default(uuid()) @db.Uuid
  matchId        String            @db.Uuid
  officialRegistrationId String    @db.Uuid
  role           MatchOfficialRole
  assignedAt     DateTime          @default(now())
  match          Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  official       OfficialProfile   @relation(fields: [officialRegistrationId], references: [registrationId], onDelete: Restrict)

  @@unique([matchId, role])
  @@index([officialRegistrationId, assignedAt])
}

model ScheduleProposal {
  id             String                 @id @default(uuid()) @db.Uuid
  competitionId  String                 @db.Uuid
  createdByUserId String                @db.Uuid
  decidedByUserId String?               @db.Uuid
  status         ScheduleProposalStatus @default(DRAFT)
  rationale      String?
  constraints    Json?
  proposal       Json
  createdAt      DateTime               @default(now())
  decidedAt      DateTime?
  competition    Competition            @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  createdBy      User                   @relation("ScheduleProposalCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  decidedBy      User?                  @relation("ScheduleProposalDecider", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@index([competitionId, status, createdAt])
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  actorUserId    String?       @db.Uuid
  organizationId String?       @db.Uuid
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([resourceType, resourceId])
}
