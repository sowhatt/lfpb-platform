generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  LEAGUE
  CLUB
}

enum Role {
  LIGUE_ADMIN
  COMPETITION_MANAGER
  SCHEDULE_APPROVER
  CLUB_ADMIN
  OFFICIEL
  SUPPORT
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum Division {
  LIGUE_1
  LIGUE_2
}

enum RegistrationCategory {
  PLAYER
  STAFF
  OFFICIAL
}

enum RegistrationStatus {
  DRAFT
  SUBMITTED
  VALIDATED
  SUSPENDED
  ARCHIVED
}

enum PlayerPosition {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
}

enum StaffFunction {
  HEAD_COACH
  ASSISTANT_COACH
  GOALKEEPER_COACH
  FITNESS_COACH
  DOCTOR
  PHYSIOTHERAPIST
  TEAM_MANAGER
  OTHER
}

enum OfficialFunction {
  REFEREE
  ASSISTANT_REFEREE
  FOURTH_OFFICIAL
  MATCH_COMMISSIONER
  DELEGATE
}

enum LicenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  SUSPENDED
  EXPIRED
}

enum DocumentType {
  IDENTITY
  PHOTO
  MEDICAL_CERTIFICATE
  CONTRACT
  TRANSFER_CLEARANCE
  OTHER
}

enum DocumentStatus {
  PENDING
  VALID
  REJECTED
  EXPIRED
}

enum SeasonStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum CompetitionFormat {
  ROUND_ROBIN
  DOUBLE_ROUND_ROBIN
  KNOCKOUT
  GROUPS_AND_KNOCKOUT
}

enum CompetitionStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MatchStatus {
  DRAFT
  SCHEDULED
  POSTPONED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VenueAssignmentType {
  PRIMARY
  ALTERNATE
}

enum ScheduleProposalStatus {
  GENERATED
  SUBMITTED
  APPROVED
  REJECTED
  PUBLISHED
}

model Organization {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  code          String         @unique
  type          OrganizationType
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  club          Club?
  memberships   Membership[]
  registrations Registration[]
  auditLogs     AuditLog[]
  competitions Competition[]

  @@index([type, active])
}

model Club {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @unique @db.Uuid
  shortName      String
  division       Division
  city           String?
  colors         String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  competitionEntries CompetitionClub[]
  homeMatches    Match[]      @relation("HomeClub")
  awayMatches    Match[]      @relation("AwayClub")
  venueAssignments ClubVenue[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([division])
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  passwordHash String
  firstName    String
  lastName     String
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships Membership[]
  auditLogs    AuditLog[]   @relation("AuditActor")
  generatedScheduleProposals ScheduleProposal[] @relation("ProposalGenerator")
  decidedScheduleProposals ScheduleProposal[] @relation("ProposalDecider")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  role           Role
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, role])
  @@index([organizationId, role, status])
}

model Person {
  id             String         @id @default(uuid()) @db.Uuid
  firstName      String
  lastName       String
  birthDate      DateTime       @db.Date
  nationality    String?
  federationId   String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  registrations  Registration[]

  @@index([lastName, firstName, birthDate])
}

model Registration {
  id             String               @id @default(uuid()) @db.Uuid
  personId       String               @db.Uuid
  organizationId String               @db.Uuid
  category       RegistrationCategory
  status         RegistrationStatus   @default(DRAFT)
  startDate      DateTime             @db.Date
  endDate        DateTime?            @db.Date
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  person         Person               @relation(fields: [personId], references: [id], onDelete: Restrict)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  playerProfile  PlayerProfile?
  staffProfile   StaffProfile?
  officialProfile OfficialProfile?
  licenses       License[]
  documents      RegistrationDocument[]

  @@index([organizationId, category, status])
  @@index([personId, status])
}

model PlayerProfile {
  registrationId String         @id @db.Uuid
  position       PlayerPosition
  shirtName      String?
  shirtNumber    Int?
  registration  Registration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

model StaffProfile {
  registrationId String        @id @db.Uuid
  function       StaffFunction
  qualification  String?
  registration   Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

model OfficialProfile {
  registrationId String           @id @db.Uuid
  function       OfficialFunction
  grade          String?
  registration   Registration     @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

model License {
  id             String        @id @default(uuid()) @db.Uuid
  registrationId String        @db.Uuid
  number         String        @unique
  season         String
  status         LicenseStatus @default(DRAFT)
  validFrom      DateTime?     @db.Date
  validUntil     DateTime?     @db.Date
  rejectionReason String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  registration  Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId, season, status])
}

model RegistrationDocument {
  id             String         @id @default(uuid()) @db.Uuid
  registrationId String         @db.Uuid
  type           DocumentType
  storageKey     String
  status         DocumentStatus @default(PENDING)
  expiresAt      DateTime?      @db.Date
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  registration  Registration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId, type, status])
}

model Season {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @unique
  startDate    DateTime     @db.Date
  endDate      DateTime     @db.Date
  status       SeasonStatus @default(DRAFT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  competitions Competition[]

  @@index([status, startDate])
}

model Competition {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  seasonId       String            @db.Uuid
  name           String
  code           String
  division       Division?
  format         CompetitionFormat
  status         CompetitionStatus @default(DRAFT)
  minRestHours   Int               @default(72)
  maxConsecutiveHome Int            @default(2)
  maxConsecutiveAway Int            @default(2)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  season         Season            @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  entries        CompetitionClub[]
  rounds         CompetitionRound[]
  matches        Match[]
  scheduleProposals ScheduleProposal[]

  @@unique([seasonId, code])
  @@index([organizationId, status])
}

model CompetitionClub {
  competitionId String      @db.Uuid
  clubId        String      @db.Uuid
  seed          Int?
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  club          Club        @relation(fields: [clubId], references: [id], onDelete: Restrict)

  @@id([competitionId, clubId])
  @@index([clubId, active])
}

model Venue {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  city         String
  address      String?
  pitchSurface String?
  capacity     Int?
  approved     Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  matches      Match[]
  clubAssignments ClubVenue[]
  unavailabilities VenueUnavailability[]

  @@unique([name, city])
  @@index([city, approved, active])
}

model ClubVenue {
  clubId      String              @db.Uuid
  venueId     String              @db.Uuid
  type        VenueAssignmentType @default(ALTERNATE)
  priority    Int                 @default(1)
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  club        Club                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  venue       Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([clubId, venueId])
  @@index([venueId, active])
  @@index([clubId, type, priority])
}

model VenueUnavailability {
  id        String   @id @default(uuid()) @db.Uuid
  venueId   String   @db.Uuid
  startsAt  DateTime
  endsAt    DateTime
  reason    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, startsAt, endsAt])
}

model CompetitionRound {
  id            String      @id @default(uuid()) @db.Uuid
  competitionId String      @db.Uuid
  number        Int
  name          String?
  startDate     DateTime?   @db.Date
  endDate       DateTime?   @db.Date
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  matches       Match[]

  @@unique([competitionId, number])
  @@index([competitionId, startDate])
}

model Match {
  id              String           @id @default(uuid()) @db.Uuid
  competitionId   String           @db.Uuid
  roundId         String?          @db.Uuid
  venueId         String?          @db.Uuid
  homeClubId      String           @db.Uuid
  awayClubId      String           @db.Uuid
  kickoffAt       DateTime?
  status          MatchStatus      @default(DRAFT)
  homeScore       Int?
  awayScore       Int?
  postponementReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  competition     Competition      @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  round           CompetitionRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)
  venue           Venue?           @relation(fields: [venueId], references: [id], onDelete: SetNull)
  homeClub        Club             @relation("HomeClub", fields: [homeClubId], references: [id], onDelete: Restrict)
  awayClub        Club             @relation("AwayClub", fields: [awayClubId], references: [id], onDelete: Restrict)

  @@index([competitionId, status, kickoffAt])
  @@index([homeClubId, kickoffAt])
  @@index([awayClubId, kickoffAt])
  @@index([venueId, kickoffAt])
}

model ScheduleProposal {
  id                String                 @id @default(uuid()) @db.Uuid
  competitionId     String                 @db.Uuid
  version           Int
  status            ScheduleProposalStatus @default(GENERATED)
  generatedBy       String
  generatedByUserId String                 @db.Uuid
  qualityScore      Int
  qualityReport     Json
  payload           Json
  submittedAt       DateTime?
  decidedAt         DateTime?
  decidedByUserId   String?                @db.Uuid
  rejectionReason   String?
  publishedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  competition       Competition            @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  generatedByUser   User                   @relation("ProposalGenerator", fields: [generatedByUserId], references: [id], onDelete: Restrict)
  decidedByUser     User?                  @relation("ProposalDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@unique([competitionId, version])
  @@index([competitionId, status, createdAt])
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  actorUserId    String?       @db.Uuid
  organizationId String?       @db.Uuid
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
}
